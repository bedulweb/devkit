# =============================================================================
# devkit secrets — COPY this file, do NOT commit the real one
#
#   cp ~/linux-devkit/.devkit.env.example ~/.devkit.env
#   nano ~/.devkit.env          # isi token asli
#   source ~/linux-devkit/scripts/export-env.sh
#   bash ~/linux-devkit/run.sh
#
# Atau satu langkah:
#   bash ~/linux-devkit/scripts/install-full.sh
# =============================================================================

# ── GitHub (optional fallback; Doppler helper is preferred) ─────────────────
# Buat di: GitHub → Settings → Developer settings → Personal access tokens
# Fine-grained: Contents = Read (repo wabase/*, wazapin/*)
# Classic: scope "repo"
GH_TOKEN=github_pat_ISI_DISINI

# Alternatif nama (gh juga baca ini):
# GITHUB_TOKEN=github_pat_ISI_DISINI

# ── Doppler (Service Token / Service Account) ───────────────────────────────
# Buat service account: dashboard.doppler.com → Project → Access → Service Accounts
#   → create service account → create token (dp.st.xxx)
# Atau project token: doppler configs tokens create <nama> --project <slug> --config <env>
DOPPLER_TOKEN=dp.st.ISI_DISINI

# Project & config default (dipakai doppler run / doppler secrets / CI)
DOPPLER_PROJECT=wazapin-platform
DOPPLER_CONFIG=dev

# Codex + PinkGreen secrets are loaded from Doppler.
# Put PINKGREEN_API_KEY, EXA_API_KEY, FIRECRAWL_API_KEY, and FIGMA_API_KEY
# in this Doppler project/config. No raw API key is stored in this file.
DEVKIT_CODEX_DOPPLER_PROJECT=developer-workstation
DEVKIT_CODEX_DOPPLER_CONFIG=dev
PINKGREEN_BASE_URL=https://ai.pinkgreen.me/v1
DEVKIT_DOPPLER_AUTOLOAD=1

# GitHub HTTPS credentials are read from this Doppler config on demand.
# The config should contain GITHUB_TOKEN (read-only service-token access is enough).
DEVKIT_GITHUB_DOPPLER_PROJECT=vendor-access
DEVKIT_GITHUB_DOPPLER_CONFIG=prd

# (opsional) host kustom / non-US cloud
# DOPPLER_API_HOST=https://api.doppler.com
# DOPPLER_DASHBOARD_HOST=https://dashboard.doppler.com

# ── Cloudflare (opsional — biasanya diisi DI DALAM Doppler vault) ───────────
# Kalau mau export manual di shell (tanpa Doppler dulu):
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# ── run.sh options ──────────────────────────────────────────────────────────
DEVKIT_PROFILE=default
DEVKIT_WITH_DOCKER=0
# herdr TUI — on by default for profile default/full
DEVKIT_WITH_HERDR=1
DEVKIT_SKIP_SKILLS=0
DEVKIT_SKIP_INSTALL_DEPS=0
DEVKIT_KIT_REPO=https://github.com/bedulweb/devkit.git

# ── aiforui.dev skills (token-gated; token lives in Doppler, not here) ───────
# Token source: AIFORUI_INSTALL_TOKEN in Doppler (default: developer-workstation/dev)
# DEVKIT_AIFORUI_DOPPLER_PROJECT=developer-workstation
# DEVKIT_AIFORUI_DOPPLER_CONFIG=dev
# DEVKIT_SKIP_AIFORUI=0
