{
  "$schema": "https://opencode.ai/config.json",
  // GENERATED from devkit repo — do not store secrets here.
  // All keys resolve at runtime via {env:VAR}.
  // Install: bash ~/linux-devkit/scripts/install-opencode.sh
  // Secrets live in Doppler (default: developer-workstation/dev):
  //   CX_API_KEY (or PINKGREEN_API_KEY), ROUTEID_API_KEY, EXA_API_KEY, FIRECRAWL_API_KEY
  // V2 server plugins. This list is the source of truth — install-opencode.sh
  // renders __HINDSIGHT_PLUGIN_DIR__ to $HOME/.hindsight/coding-agents, and
  // comments the entry out when that plugin is not installed (it is optional and
  // a missing plugin path is a hard load error).
  // opencode-firecrawl needs no entry here: it auto-loads from
  // ~/.config/opencode/plugins/ (synced by scripts/install-opencode-plugins.sh).
  // opencode-with-claude (bare package name) resolves to the remote-patched
  // seed at ~/.cache/opencode/node_modules/opencode-with-claude, installed by
  // scripts/install-opencode-claude-remote.sh. install-opencode.sh comments
  // this entry out when the seed is absent (same rule as hindsight).
  "plugins": [
    "__HINDSIGHT_PLUGIN_DIR__",
    "opencode-with-claude"
  ],
  "providers": {
    // Claude Max via remote Meridian proxy over Tailscale (client mode — no
    // local `claude auth login` needed). The plugin overwrites baseURL per
    // request and attaches session headers; without them long requests get
    // HTTP 402 (cold lineage). apiKey resolves from ~/.config/opencode/.env
    // (CLAUDE_PROXY_API_KEY=dummy), written by install-opencode-claude-remote.sh.
    "anthropic": {
      "env": ["CLAUDE_PROXY_API_KEY"],
      "settings": {
        "baseURL": "http://100.74.3.7:3456/v1",
        "apiKey": "{env:CLAUDE_PROXY_API_KEY}"
      },
      "models": {
        "claude-sonnet-5-5": {
          "name": "Claude Sonnet 5.5 (remote)",
          "limit": { "context": 200000, "output": 64000 }
        },
        "claude-opus-5-5": {
          "name": "Claude Opus 5.5 (remote)",
          "limit": { "context": 1000000, "output": 128000 }
        },
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8 (remote)",
          "limit": { "context": 1000000, "output": 128000 }
        },
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5 (remote)",
          "limit": { "context": 200000, "output": 64000 }
        },
        "claude-haiku-4-5": {
          "name": "Claude Haiku 4.5 (remote)",
          "limit": { "context": 200000, "output": 64000 }
        }
      }
    },
    "cx": {
      "name": "SaberGaming CX",
      "env": ["PINKGREEN_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://ai.sabergaming.my.id/v1",
        "apiKey": "{env:PINKGREEN_API_KEY}"
      },
      "models": {
        "gpt-5.6-sol": {
          "modelID": "cx/gpt-5.6-sol",
          "name": "CX GPT-5.6 Sol",
          "limit": { "context": 372000, "output": 128000 },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ]
        },
        "gpt-5.6-terra": {
          "modelID": "cx/gpt-5.6-terra",
          "name": "CX GPT-5.6 Terra",
          "limit": { "context": 272000, "output": 128000 },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ]
        },
        "gpt-5.6-luna": {
          "modelID": "cx/gpt-5.6-luna",
          "name": "CX GPT-5.6 Luna",
          "limit": { "context": 272000, "output": 128000 },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ]
        },
        "gpt-6-astra": {
          "modelID": "cx/gpt-6-astra",
          "name": "CX GPT-6 Astra",
          "limit": { "context": 272000, "output": 128000 },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ]
        },
        "gpt-6": {
          "modelID": "cx/gpt-6",
          "name": "CX GPT-6",
          "limit": { "context": 272000, "output": 128000 },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ]
        },
        "gpt-6-luna": {
          "modelID": "cx/gpt-6-luna",
          "name": "CX GPT-6 Luna",
          "limit": { "context": 272000, "output": 128000 },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ]
        },
        "gpt-6-sol": {
          "modelID": "cx/gpt-6-sol",
          "name": "CX GPT-6 Sol",
          "limit": { "context": 372000, "output": 128000 },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ]
        },
        "gpt-6.1-sol": {
          "modelID": "cx/gpt-6.1-sol",
          "name": "CX GPT-6.1 Sol",
          "limit": { "context": 372000, "output": 128000 },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ]
        },
        "gpt-6-terra": {
          "modelID": "cx/gpt-6-terra",
          "name": "CX GPT-6 Terra",
          "limit": { "context": 272000, "output": 128000 },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ]
        }
      }
    },
    "hv": {
      "name": "SaberGaming HV",
      "env": ["PINKGREEN_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://ai.sabergaming.my.id/v1",
        "apiKey": "{env:PINKGREEN_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "modelID": "hv/deepseek-ai/deepseek-v4.1-flash",
          "name": "HV DeepSeek V4.1 Flash",
          "limit": { "context": 1000000, "output": 384000 }
        }
      }
    },
    "routeid": {
      "name": "RouteID",
      "env": ["ROUTEID_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://routeid.trainerhub.workers.dev/v1",
        "apiKey": "{env:ROUTEID_API_KEY}"
      },
      "models": {
        "kimi-k3": {
          "name": "RouteID Kimi K3",
          "limit": { "context": 1048576, "output": 1048576 }
        },
        "glm-5.2": {
          "name": "RouteID GLM-5.2",
          "limit": { "context": 1048576, "output": 131072 }
        },
        "deepseek-v4-pro-0813": {
          "name": "RouteID DeepSeek V4 Pro 0813",
          "limit": { "context": 1048576, "output": 393216 }
        },
        "deepseek-v4-flash-0731": {
          "name": "RouteID DeepSeek V4 Flash 0731",
          "limit": { "context": 1048576, "output": 393216 }
        },
        "qwen3.8-max": {
          "name": "RouteID Qwen3.8 Max",
          "limit": { "context": 1048576, "output": 131072 }
        },
        "qwen3.8-flash": {
          "name": "RouteID Qwen3.8 Flash",
          "limit": { "context": 1048576, "output": 131072 }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "mobbin": {
        "type": "remote",
        "url": "https://api.mobbin.com/mcp"
      },
      "firecrawl": {
        "type": "local",
        "command": ["bunx", "-y", "firecrawl-mcp"],
        "environment": {
          "FIRECRAWL_API_KEY": "{env:FIRECRAWL_API_KEY}"
        }
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp",
        "oauth": false,
        "headers": {
          "x-api-key": "{env:EXA_API_KEY}"
        }
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      },
      "agentation": {
        "type": "local",
        "command": ["npx", "-y", "agentation-mcp", "server", "--mcp-only", "--http-url", "https://agentation.wzpn.net"],
        "enabled": true
      },
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp"
      },
      "neon": {
        "type": "remote",
        "url": "https://mcp.neon.tech/mcp"
      }
    }
  }
}
