[Unit]
Description=devkit restic forget+prune (keep 24h hourly, 7d daily, 4w weekly)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__DEVKIT_USER__
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/linux-devkit/scripts/restic-backup.sh forget
