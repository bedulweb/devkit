[Unit]
Description=devkit restic forget+prune (keep 24h hourly, 7d daily, 4w weekly)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=HOME=/root
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/root/linux-devkit/scripts/restic-backup.sh forget
