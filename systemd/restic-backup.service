[Unit]
Description=devkit restic backup ($HOME/projects → R2)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__DEVKIT_USER__
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/linux-devkit/scripts/restic-backup.sh backup
